index 998c013..f324d97 100644
--- a/backend/.env.example
+++ b/backend/.env.example
@@ -6,9 +6,16 @@ DEFAULT_DAILY_SOFT_LIMIT_USD=3
 DEFAULT_DAILY_HARD_LIMIT_USD=8
 DEFAULT_MONTHLY_HARD_LIMIT_USD=50
 
-# Local storage and SQLite persistence
+# Local storage and SQLite persistence.
+# STORAGE_DIR is PUBLICLY SERVED at /artifacts — never point private files there.
+# PRIVATE_DIR holds the database and admin data; it is never served.
 STORAGE_DIR=./storage
-SQLITE_DB_PATH=./storage/synthwave.db
+PRIVATE_DIR=./private
+SQLITE_DB_PATH=./private/synthwave.db
+
+# Registration policy. Empty invite list = registration CLOSED (fail closed).
+# Set to true only if you intentionally want public sign-ups.
+ALLOW_OPEN_REGISTRATION=false
 FFMPEG_PATH=ffmpeg
 
 # OpenAI (optional for real prompt + image generation)
