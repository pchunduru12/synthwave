PORT=3000
API_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-strong-secret

DEFAULT_DAILY_SOFT_LIMIT_USD=3
DEFAULT_DAILY_HARD_LIMIT_USD=8
DEFAULT_MONTHLY_HARD_LIMIT_USD=50

# Local storage and SQLite persistence
STORAGE_DIR=./storage
SQLITE_DB_PATH=./storage/synthwave.db
FFMPEG_PATH=ffmpeg

# OpenAI (optional for real prompt + image generation)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Mock mode: true = no paid provider calls; false = use configured providers
ENABLE_MOCK_PROVIDERS=true

# Optional Suno adapter (only if you have an API-compatible endpoint)
SUNO_ENABLED=false
SUNO_API_BASE_URL=
SUNO_API_KEY=
